# ----------------------------------------------------
# Backend environment variables for AI analysis
# ----------------------------------------------------

# OpenAI-compatible API key (required for AI resume analysis)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI-compatible API base URL (override for Groq, OpenRouter, etc.)
# OPENAI_API_BASE=https://api.openai.com/v1

# LLM model to use for analysis
# LLM_MODEL=gpt-4o-mini

# ----------------------------------------------------
# Frontend: set VITE_API_BASE_URL for local development
# ----------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
